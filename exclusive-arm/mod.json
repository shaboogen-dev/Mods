{
  "manifest_version": 2,
  "mod": {
    "id": "exclusive-arm",
    "name": "Track: Exclusive Arm",
    "area": "Track",
    "version": "0.1.0-dev.5",
    "author": "shaboogen",
    "description": "Arming a track for recording disarms every other track. Shift-click an arm button to arm only that track, even with the option off.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" }
  },
  "requires": [
    { "id": "preferences-composition-framework", "min_version": "0.3.0-dev.7" },
    { "id": "action-menu-composition-framework", "min_version": "0.5.1-dev.1" }
  ],
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    },
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
