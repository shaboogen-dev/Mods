{
  "manifest_version": 2,
  "mod": {
    "id": "exclusive-arm",
    "name": "Track: Exclusive Arm",
    "area": "Track",
    "version": "1.0.0",
    "author": "shaboogen",
    "description": "Adds a setting that mirrors the functionality of Exclusive Solo for the Record Arm button",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" }
  },
  "requires": [
    { "id": "preferences-composition-framework", "min_version": "1.0.0" },
    { "id": "action-menu-composition-framework", "min_version": "0.9.0-dev.4" }
  ],
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ]
}
