{
  "manifest_version": 2,
  "mod": {
    "id": "side-browser-enter-selected-device",
    "name": "Browser (side): Enter Inserts Selected Result",
    "area": "Browser (side)",
    "version": "1.0.0",
    "author": "shaboogen",
    "description": "Allows you to use Enter to load results from the side browser",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
