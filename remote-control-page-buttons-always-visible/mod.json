{
  "manifest_version": 2,
  "mod": {
    "id": "remote-control-page-buttons-always-visible",
    "name": "Device: Always Show Remote Control Page Buttons",
    "area": "Device",
    "version": "1.3.0",
    "author": "shaboogen",
    "description": "Restores Previous and Next buttons to cycle Remote Control pages on devices",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}
