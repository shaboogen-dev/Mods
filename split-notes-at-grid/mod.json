{
  "manifest_version": 2,
  "mod": {
    "id": "split-notes-at-grid",
    "name": "Piano Roll: Split Notes at Grid",
    "area": "Piano Roll",
    "version": "0.1.0-dev.1",
    "author": "kalifrn",
    "description": "Cuts the selected notes on the grid lines inside them, as one Undo step. In the notes' right-click menu, and as an action you can give a key in Settings > Shortcuts.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "action-menu-composition-framework", "min_version": "0.8.0-dev.1" },
    { "id": "piano-roll-framework", "min_version": "0.1.0-dev.11" }
  ],
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
