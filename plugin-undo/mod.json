{
  "manifest_version": 2,
  "mod": {
    "id": "plugin-undo",
    "name": "Device: VST / CLAP Plugin Undo Toggle",
    "area": "Device",
    "version": "1.1.0",
    "author": "shaboogen",
    "description": "Adds a setting to turn off undo on VST / CLAP plugins",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "preferences-composition-framework", "min_version": "1.0.0" }
  ],
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}
