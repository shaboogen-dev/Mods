{
  "manifest_version": 2,
  "mod": {
    "id": "plugin-undo",
    "name": "Device: Optional Plug-in Undo Steps",
    "area": "Device",
    "version": "1.1.0-dev.3",
    "author": "shaboogen",
    "description": "Changes made inside VST and CLAP plug-ins no longer fill Bitwig's Undo history. Turn them back on in Settings > Mods.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "preferences-composition-framework", "min_version": "1.0.0" }
  ],
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}
