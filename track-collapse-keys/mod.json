{
  "manifest_version": 2,
  "mod": {
    "id": "track-collapse-keys",
    "name": "Arranger: Collapse and Expand Shortcuts",
    "area": "Arranger",
    "version": "0.2.0-dev.1",
    "author": "kalifrn",
    "description": "Adds Collapse Track and Expand Track shortcuts for the selected arranger tracks: a track goes to its smallest height and back, a group folds and unfolds. Assign the keys in Settings > Shortcuts.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "action-menu-composition-framework", "min_version": "0.8.0-dev.1" },
    { "id": "shortcut-share-key", "min_version": "0.1.0-dev.1" }
  ],
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}
