{
  "manifest_version": 2,
  "mod": {
    "id": "add-automation-points",
    "name": "Arranger: Add Automation Points",
    "area": "Arranger",
    "version": "1.1.0-dev.3",
    "author": "shaboogen",
    "description": "Adds points at the start and end of an automation time selection, with the values and the curve you set in a dialog.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
