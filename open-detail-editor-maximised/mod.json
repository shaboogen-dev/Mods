{
  "manifest_version": 2,
  "mod": {
    "id": "open-detail-editor-maximised",
    "name": "Detail Editor: Open Maximised",
    "area": "Detail Editor",
    "version": "1.0.0",
    "author": "shaboogen",
    "description": "Adds a setting to have clips open maximised as the default behaviour",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "preferences-composition-framework", "min_version": "1.0.0" }
  ],
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    }
  ],
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" }
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.bitwig.mods.opendetaileditormaximised.OpenDetailEditorMaximised"
  }
}
