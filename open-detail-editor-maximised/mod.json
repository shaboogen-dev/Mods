{
  "manifest_version": 2,
  "mod": {
    "id": "open-detail-editor-maximised",
    "name": "Detail Editor: Open Maximised",
    "area": "Detail Editor",
    "version": "0.1.0-dev.1",
    "author": "shaboogen",
    "description": "Opening a clip in the Detail Editor shows the Detail Editor as the main content, as Bitwig's Toggle maximized editing mode does.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" }
  },
  "helper": {
    "jar": "helper.jar",
    "class": "com.bitwig.mods.opendetaileditormaximised.OpenDetailEditorMaximised"
  }
}
