{
  "manifest_version": 2,
  "mod": {
    "id": "device-toggle-enabled-key",
    "name": "Device: Toggle Enabled Shortcut",
    "area": "Device",
    "version": "0.1.0-dev.1",
    "author": "kalifrn",
    "description": "Adds a Toggle Device Enabled shortcut that switches the selected devices in a device chain on or off. Assign the key in Settings > Shortcuts.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "action-menu-composition-framework", "min_version": "0.8.0-dev.1" }
  ],
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}
