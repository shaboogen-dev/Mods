{
  "manifest_version": 2,
  "mod": {
    "id": "single-parameter-randomizer",
    "name": "Parameter: Randomise Hovered Parameter",
    "area": "Parameter",
    "version": "1.4.0-dev.2",
    "author": "shaboogen",
    "description": "Sets one parameter to a random value: the one under the mouse when you press the shortcut, or the one you right-click.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "requires": [
    { "id": "action-menu-composition-framework", "min_version": "0.8.0-dev.1" }
  ],
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  }
}
