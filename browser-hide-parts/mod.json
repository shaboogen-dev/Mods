{
  "manifest_version": 2,
  "mod": {
    "id": "browser-hide-parts",
    "name": "Browser: Hide Parts",
    "area": "Browser",
    "version": "0.1.0-dev.1",
    "author": "shaboogen",
    "description": "Hides parts of the side browser you don't use: the Quick Sources toolbar, the filters, search suggestions and the details pane. Choose them in Settings > Mods.",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.4",
    "platform": "windows",
    "architecture": "x64"
  },
  "resources": {
    "readme": { "kind": "file", "path": "README.md", "media_type": "text/markdown" }
  },
  "requires": [
    { "id": "preferences-composition-framework", "min_version": "1.0.0" },
    { "id": "browser-framework", "min_version": "0.3.0-dev.1" }
  ],
  "registrations": [
    {
      "id": "preferences",
      "consumer": "preferences-composition-framework",
      "descriptor": "preferences.properties",
      "jar": "helper.jar"
    },
    {
      "id": "browser",
      "consumer": "browser-framework",
      "descriptor": "browser.properties",
      "jar": "helper.jar"
    }
  ]
}
